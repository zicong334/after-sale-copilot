# 售后 Copilot 环境变量示例(复制为 .env 后填写;.env 已在 .gitignore,禁止提交)
# 只有 W4-C 真实评测/S6 才需要这些值;pytest 永远不读 .env,无 key 时自动用 FakeLLM。

# 必填:真实 LLM 的 API key(只在本机 .env 中出现,绝不写入代码/日志/报告)
LLM_API_KEY=

# 可选:OpenAI 兼容 base_url(默认 DeepSeek)
LLM_BASE_URL=https://api.deepseek.com/v1

# 可选:模型 ID
LLM_MODEL=deepseek-flash

# 可选:单价(美元/百万 token)。留空则报告 meta.pricing.status=TBD,token 仍为真实值
LLM_PRICE_IN_PER_MTOK=
LLM_PRICE_OUT_PER_MTOK=

# 可选:真实请求/响应抓包 JSONL(自动脱敏,不含 Authorization/key;默认关闭)
# LLM_CAPTURE_PATH=.tmp/llm_capture.jsonl
